# ============================================
# GEMMA Ecosystem - Environment Variables
# ============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# --- Anthropic Claude API (for GEMMA Insights article generation) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- CryptoPanic API (for Global Crypto Radar news feed) ---
CRYPTOPANIC_API_KEY=your-cryptopanic-api-key

# --- Admin Authentication ---
# Generate hash: node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your-password', 10).then(h => console.log(h));"
ADMIN_PASSWORD_HASH=$2a$10$your-bcrypt-hash-here
ADMIN_JWT_SECRET=your-random-secret-string-here

# --- Vercel Blob Storage (for article persistence) ---
BLOB_READ_WRITE_TOKEN=vercel_blob_your-token-here
